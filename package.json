{
  "name": "trading-journal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:messages": "node scripts/check-messages.mjs",
    "check:index": "node scripts/check-project-index.mjs",
    "check": "npm run check:index && npm run check:messages && npm run typecheck && npm test && npm run build",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler/dry"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
